#!/usr/bin/env bash

SCRIPT_NAME="Install Deb Package"
source "$(dirname -- "$(realpath -- "$0")")/../lib/common.sh" || exit 1

mapfile -t debs < <(selected_paths | grep -i '\.deb$')
[ "${#debs[@]}" -gt 0 ] || die "No .deb file selected"

if ! command -v gnome-terminal >/dev/null 2>&1; then
  die "gnome-terminal is required to run the install"
fi

# Nautilus started from a terminal inherits that terminal's screen id, which
# breaks gnome-terminal once that terminal is closed.
unset GNOME_TERMINAL_SCREEN

# The .deb paths are passed as "$@" so names with spaces need no escaping.
# The final read keeps the window open to show apt's result.
gnome-terminal -- bash -c 'printf "$ sudo apt install -- %s\n" "$*"; sudo apt install -- "$@"; read -rp "Press Enter to close..."' _ "${debs[@]}" >/dev/null 2>&1 &
