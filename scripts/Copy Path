#!/usr/bin/env bash

SCRIPT_NAME="Copy Path"
source "$(dirname -- "$(realpath -- "$0")")/../lib/common.sh" || exit 1

paths="$(selected_paths)"
[ -n "$paths" ] || die "No file or folder selected"

if ! printf '%s' "$paths" | copy_to_clipboard; then
  die "Clipboard copy failed. Install or fix xclip, xsel, or wl-copy."
fi

notify "Copied full path(s)"
