#!/usr/bin/env bash

SCRIPT_NAME="Make Executable"
source "$(dirname -- "$(realpath -- "$0")")/../lib/common.sh" || exit 1
changed=0

paths="$(selected_paths)"
[ -n "$paths" ] || die "No file selected"

while IFS= read -r path; do
  [ -n "$path" ] || continue
  [ -f "$path" ] || continue

  if chmod +x -- "$path"; then
    changed=$((changed + 1))
  fi
done <<EOF
$paths
EOF

[ "$changed" -gt 0 ] || die "No regular files were updated"
notify "Marked ${changed} file(s) as executable"
