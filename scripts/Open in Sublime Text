#!/usr/bin/env bash

SCRIPT_NAME="Open in Sublime Text"
source "$(dirname -- "$(realpath -- "$0")")/../lib/common.sh" || exit 1

mapfile -t paths < <(selected_paths)
[ "${#paths[@]}" -gt 0 ] || die "No file or folder selected"

sublime_cmd="$(find_command \
  subl \
  /opt/sublime_text/sublime_text \
  /usr/bin/subl \
  /snap/bin/subl)" || die "Sublime Text command not found"
"$sublime_cmd" "${paths[@]}" >/dev/null 2>&1 &
