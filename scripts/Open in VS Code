#!/usr/bin/env bash

SCRIPT_NAME="Open in VS Code"
source "$(dirname -- "$(realpath -- "$0")")/../lib/common.sh" || exit 1

mapfile -t paths < <(selected_paths)
[ "${#paths[@]}" -gt 0 ] || die "No file or folder selected"

code_cmd="$(find_command \
  code \
  code-insiders \
  codium \
  /snap/bin/code \
  /snap/bin/code-insiders \
  /usr/bin/code)" || die "VS Code command not found"
"$code_cmd" "${paths[@]}" >/dev/null 2>&1 &
